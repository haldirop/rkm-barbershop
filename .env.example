# ═══════════════════════════════════════════════════════════════════════════
#  RKM Barbershop — instellingen (environment variables)
#
#  Online (Vercel): vul deze waarden in bij Project → Settings → Environment Variables.
#  Lokaal: kopieer dit bestand naar .env.local en vul daar de waarden in.
#  Deel deze waarden nooit met anderen en zet ze nooit in de code: .env.local
#  wordt bewust niet meegestuurd naar GitHub.
#  Waar je elke waarde vindt: zie docs/ONLINE-ZETTEN.md.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Website ───────────────────────────────────────────────────────────────
# Het adres van je website, zonder / aan het eind. Gebruikt in e-mails en voor Google.
SITE_URL=https://www.rkmbarbershop.nl

# Geheime sleutel (minimaal 32 willekeurige tekens) voor de beveiligde links in
# klantmails. Eén keer instellen en daarna nooit meer wijzigen.
APP_SECRET=

# ─── Database (Supabase → Connect → "Transaction pooler") ─────────────────
# Vervang [YOUR-PASSWORD] door je databasewachtwoord.
# Lokaal zonder Supabase: laat staan op pglite:./.data/pglite (ingebouwde database).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# ─── Inloggen beheer (Supabase → Project Settings → API Keys) ─────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "Publishable key" (begint met sb_publishable_). Oudere projecten: de "anon" key.
SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (begint met sb_secret_). Oudere projecten: de "service_role" key.
# Alleen nodig om vanuit het beheer extra beheerders toe te voegen. Blijft altijd op de server.
SUPABASE_SECRET_KEY=

# Jouw e-mailadres. Dit wordt de eerste beheerder (eigenaar) en ontvangt meldingen
# van nieuwe afspraakaanvragen.
ADMIN_EMAIL=jouw@email.nl

# ─── E-mail (Resend → API Keys) ───────────────────────────────────────────
# Zonder deze twee worden e-mails alleen gelogd en niet verstuurd.
RESEND_API_KEY=
# Afzender. Het domein moet in Resend geverifieerd zijn.
# Om te testen vóór je domein klaar is: RKM Barbershop <onboarding@resend.dev>
# (dan kun je alleen naar het e-mailadres van je Resend-account sturen).
EMAIL_FROM=RKM Barbershop <afspraken@rkmbarbershop.nl>

# ─── Herinneringsmails ────────────────────────────────────────────────────
# Beveiligt de dagelijkse herinneringstaak (minimaal 16 willekeurige tekens).
CRON_SECRET=

# ─── Alleen voor lokale ontwikkeling zonder Supabase ──────────────────────
# Wachtwoord voor de lokale login van ADMIN_EMAIL (wordt online niet gebruikt).
# ADMIN_PASSWORD=
